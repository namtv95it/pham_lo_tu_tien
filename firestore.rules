rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép người dùng đã xác thực đọc/ghi vào hồ sơ của chính họ
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tạm thời cho phép môi trường dev thử nghiệm (hoặc bật quy tắc trên)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

